{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignore": [".agents/**", ".local/**"],
	"workspaces": {
		"apps/server": {
			// Mirrors apps/server/knip.jsonc (root `knip` does not pick up
			// per-workspace config files on its own).
			"entry": [
				"src/server.ts",
				"src/tests/**/*.test.ts",
				"src/infra/index.ts",
				"src/infra/logger/request-context.ts",
				"src/infra/database/index.ts",
				"src/infra/numbering/index.ts",
				"src/shared/schema/index.ts",
				"src/shared/auth/index.ts",
				"src/server/plugins/auth.plugin.ts",
				"src/tests/helpers/request.ts",
				"src/modules/**/index.ts",
				"src/modules/**/*.contract.ts",
				"src/shared/types/pagination.ts",
				"src/shared/types/utils.ts",
			],
			"project": ["src/**/*.ts"],
			"ignoreDependencies": ["lint-staged"],
			"ignoreBinaries": ["flyctl"],
			"ignoreIssues": {
				"src/server/plugins/auth.plugin.ts": ["duplicates"],
			},
		},
		"apps/web": {
			// The vendored shadcn/reui component kit is consumed on demand, and
			// `index.ts` files are module public-API barrels.
			"entry": [
				"src/components/ui/**/*.{ts,tsx}",
				"src/components/reui/**/*.{ts,tsx}",
				"src/**/index.ts",
			],
			"project": ["src/**/*.{ts,tsx,css}"],
			// Router codegen is done by @tanstack/router-plugin; the CLI is unused.
			"ignoreDependencies": ["@tanstack/router-cli"],
			// Dead convenience wrapper (all call sites use @/components/ui/toast).
			"ignoreFiles": ["src/lib/toast.ts"],
			// Helpers exported for tests/colocated use but only used in-file.
			"ignoreExportsUsedInFile": true,
		},
		"apps/e2e": {
			"project": ["tests/**/*.ts"],
			"ignoreExportsUsedInFile": true,
		},
	},
}
