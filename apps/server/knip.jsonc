{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"src/server.ts",
		"src/infra/otel/otel.ts",
		"src/tests/**/*.test.ts"
	],
	"project": [
		"src/**/*.ts"
	],
	"ignoreDependencies": [
		"@total-typescript/ts-reset",
		"bcrypt",
		"lint-staged"
	],
	"ignoreBinaries": [
		"flyctl"
	]
}