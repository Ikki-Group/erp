{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": ["src/server.ts", "src/tests/**/*.test.ts", "scripts/*.ts"],
	"project": ["src/**/*.ts", "scripts/**/*.ts"],
	// drizzle.config.ts requires DATABASE_URL at load time; the schema is reached through code anyway.
	"drizzle": false,
	"ignoreDependencies": ["@total-typescript/ts-reset", "lint-staged"],
	"ignoreBinaries": ["flyctl"],
}
