NODE_ENV=development
COMMIT_SHA=

# App
APP_NAME=ikki-erp
APP_ENV=local

# Server
PORT=8080
HOST=0.0.0.0
TZ=Asia/Jakarta

# Log
LOG_LEVEL="debug"
LOG_FORMAT="pretty"

# Database (required)
DATABASE_URL=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Logger
LOG_PRETTY="true"
LOG_PATTERN="dev"

# Observability
AXIOM_URL=
AXIOM_TOKEN=
AXIOM_DATASET=

OTEL_LOGS_ENABLED=true
OTEL_SEMCONV_STABILITY_OPT_IN="http/dup,database/dup"

# Redis / Upstash (standard connection string, e.g. rediss://default:<password>@<host>:6379)
# Leave empty for L1-memory-only cache (local dev/tests).
REDIS_URL=