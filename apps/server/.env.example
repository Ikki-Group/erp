NODE_ENV=development
COMMIT_SHA=

# App
APP_NAME=ikki-erp
APP_ENV=local

# Server
PORT=8080
HOST=0.0.0.0
TZ=Asia/Jakarta

# CORS (comma-separated origins; REQUIRED in production, "*" must be explicit)
# Dev/test default: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=

# Log
LOG_LEVEL="debug"
LOG_FORMAT="pretty"

# Database (required)
DATABASE_URL=
DB_POOL_MAX=10
# Migrations dir for the compiled ./dist/migrate binary (default: <binary dir>/migrations)
# MIGRATIONS_DIR=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Auth rate limiting (enabled by default except NODE_ENV=test)
# AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Logger
LOG_PRETTY="true"
LOG_PATTERN="dev"

# Observability
AXIOM_URL=
AXIOM_TOKEN=
AXIOM_DATASET=

OTEL_LOGS_ENABLED=true
OTEL_SEMCONV_STABILITY_OPT_IN="http/dup,database/dup"

# Redis / Upstash (standard connection string, e.g. rediss://default:<password>@<host>:6379)
# Leave empty for L1-memory-only cache (local dev/tests).
REDIS_URL=