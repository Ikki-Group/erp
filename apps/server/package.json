{
	"name": "@ikki/server",
	"version": "1.0.50",
	"scripts": {
		"dev": "NODE_ENV=development bun run --watch src/server.ts",
		"dev:debug": "bun run --watch --inspect src/server.ts",
		"dev:db:reset": "NODE_ENV=development bun run scripts/db-scripts-helper.ts all",
		"build": "bun build --compile --outfile ./dist/server ./src/server.ts",
		"start": "bun run dist/server.js",
		"test": "NODE_ENV=test bun test --bail",
		"test:coverage": "NODE_ENV=test bun test --coverage",
		"test:db:reset": "NODE_ENV=test bun run scripts/db-scripts-helper.ts all",
		"test:watch": "NODE_ENV=test bun test --watch",
		"db:generate": "bunx --bun drizzle-kit generate",
		"db:migrate": "bunx --bun drizzle-kit migrate",
		"db:studio": "bunx --bun drizzle-kit studio",
		"db:reset": "bun run scripts/db-scripts-helper.ts reset",
		"db:seed": "bun run scripts/db-scripts-helper.ts seed",
		"seed": "bun run scripts/seed.ts",
		"lint": "oxlint --type-aware .",
		"lint:fix": "oxlint --type-aware --fix --fix-suggestions --fix-dangerously .",
		"format": "oxfmt",
		"check": "oxfmt -w . && oxlint --fix .",
		"knip": "bunx --bun knip --config knip.jsonc",
		"typecheck": "tsc --noEmit",
		"check-deps": "dpdm --no-tree --no-warning --exit-code circular:1 src/server.ts",
		"verify": "bun run lint && bun run typecheck && bun run knip && bun run check-deps",
		"fly:deploy": "flyctl deploy"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/opentelemetry": "^1.4.11",
		"@logtape/logtape": "^2.3.0",
		"@logtape/otel": "^2.3.0",
		"@logtape/pretty": "^2.3.0",
		"@neondatabase/serverless": "^1.1.0",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/api-logs": "^0.221.0",
		"@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
		"@opentelemetry/instrumentation-pg": "^0.73.0",
		"@opentelemetry/otlp-exporter-base": "^0.221.0",
		"@opentelemetry/sdk-logs": "^0.221.0",
		"@opentelemetry/sdk-node": "^0.221.0",
		"@opentelemetry/sdk-trace-base": "^2.10.0",
		"@opentelemetry/sdk-trace-node": "^2.10.0",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/jsonwebtoken": "^9.0.10",
		"axios": "^1.19.0",
		"bcrypt": "^6.0.0",
		"bentocache": "^1.6.1",
		"cache-manager": "^7.2.9",
		"date-fns": "^4.4.0",
		"decimal.js": "^10.6.0",
		"drizzle-orm": "^0.45.2",
		"elysia": "^1.4.29",
		"es-toolkit": "^1.50.0",
		"ioredis": "^6.0.0",
		"jsonwebtoken": "^9.0.3",
		"ms": "^2.1.3",
		"ohash": "^2.0.11",
		"postgres": "^3.4.9",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/ms": "^2.1.0",
		"dpdm": "^4.3.0",
		"drizzle-kit": "^0.31.10",
		"knip": "^6.32.0",
		"lint-staged": "^17.3.0",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"typescript": "^7.0.2"
	},
	"lint-staged": {
		"**/*.{ts,tsx,js,jsx}": [
			"oxlint --fix",
			"oxfmt -w"
		]
	}
}
