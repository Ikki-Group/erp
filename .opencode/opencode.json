{
	"$schema": "https://opencode.ai/config.json",
	"instructions": ["AGENTS.md"],
	"plugin": ["@tarquinen/opencode-dcp"],
	"compaction": {
		"auto": true,
		"prune": true,
		"tail_turns": 15
	},
	"tool_output": {
		"max_lines": 500,
		"max_bytes": 24576
	},
	"mcp": {
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true
		},
		"playwright": {
			"type": "local",
			"command": ["bunx", "@playwright/mcp@latest"],
			"enabled": true
		}
	}
}
