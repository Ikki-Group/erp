{
  "mcpServers": {
    "reui": {
      "type": "http",
      "url": "https://mcp.reui.io"
    },
    "codegraph": {
      "args": [
        "serve",
        "--mcp"
      ],
      "command": "codegraph",
      "disabledTools": [],
      "type": "stdio"
    },
    "memory": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "autoApprove": [],
      "command": "npx",
      "disabled": false
    },
    "playwright": {
      "args": [
        "@playwright/mcp@latest"
      ],
      "command": "npx",
      "disabledTools": []
    }
  }
}