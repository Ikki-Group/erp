{
  "mcpServers": {
    "reui": {
      "type": "http",
      "url": "https://mcp.reui.io"
    },
    "codegraph": {
      "args": [
        "serve",
        "--mcp"
      ],
      "command": "codegraph",
      "disabledTools": [],
      "type": "stdio"
    },
    "gortex": {
      "args": [
        "mcp"
      ],
      "autoApprove": [
        "analyze",
        "capabilities",
        "change",
        "explore",
        "read",
        "recall",
        "relations",
        "response",
        "search",
        "trace",
        "workspace"
      ],
      "command": "gortex",
      "disabled": false,
      "env": {
        "GORTEX_INDEX_WORKERS": "8"
      }
    },
    "memory": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "autoApprove": [],
      "command": "npx",
      "disabled": false
    },
    "playwright": {
      "args": [
        "@playwright/mcp@latest"
      ],
      "command": "npx",
      "disabledTools": []
    }
  }
}