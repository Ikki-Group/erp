{
	"servers": {
		"tsgo": {
			"command": "apps/web/node_modules/.bin/tsc",
			"args": ["--lsp", "--stdio"],
			"fileTypes": [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"],
			"rootMarkers": ["package.json"]
		},
		"oxlint": {
			"command": "oxlint",
			"args": ["--lsp"],
			"fileTypes": [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"],
			"rootMarkers": [".oxlintrc.json"],
			"isLinter": true
		},
		"oxfmt": {
			"command": "oxfmt",
			"args": ["--lsp"],
			"fileTypes": [
				".ts",
				".tsx",
				".mts",
				".cts",
				".js",
				".jsx",
				".mjs",
				".cjs",
				".json",
				".jsonc",
				".css",
				".md",
				".yml",
				".yaml"
			],
			"rootMarkers": [".oxfmtrc.json"],
			"isLinter": true
		}
	}
}
