{
	"name": "@ikki/api-contract",
	"version": "0.1.0",
	"description": "Shared API contract types and validators for Ikki ERP",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./core": {
			"types": "./src/core/index.ts",
			"default": "./src/core/index.ts"
		},
		"./validation": {
			"types": "./src/validation/index.ts",
			"default": "./src/validation/index.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"typescript": "^5.6.3"
	}
}
